# Copy to env.local (or any path) and edit before running deploy.sh.
# deploy.sh usage: ./deploy.sh [path/to/env-file]

# Deployment name and label
APP_NAME=my-deck

# Namespace to deploy into
NAMESPACE=user-demo

# ConfigMap name (the deck HTML is mounted from it)
CONFIGMAP_NAME=my-deck-html

# Path to the deck HTML file to serve
DECK_FILE=./deck.html
